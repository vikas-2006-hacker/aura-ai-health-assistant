DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura
JWT_SECRET_KEY=<CHANGE_ME>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
### Example environment variables for AURA backend
# Replace the placeholder values with your real PostgreSQL connection details.
# Use the `psycopg` driver in the URL scheme for SQLAlchemy 2.x:
# Format: postgresql+psycopg://<user>:<PASSWORD>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@localhost:5432/aura
ENV=development
APP_NAME=AURA
APP_VERSION=0.1.0
DEBUG=false
CORS_ORIGINS=*
